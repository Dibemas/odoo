<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Add Approver Fields on Journal View -->
        <record id="account_journal_form_approver" model="ir.ui.view">
            <field name="name">account.journal.form</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.view_account_journal_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='type']" position="after">
                    <field name="is_credit_card" widget='boolean_toggle'/>
                </xpath>
            </field>
        </record>

        <record id="view_account_journal_dashboard_credit_card_button" model="ir.ui.view">
            <field name="name">account.journal.dashboard.credit.card.import</field>
            <field name="model">account.journal</field>
            <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
            <field name="arch" type="xml">

                <xpath expr="//div[@id='dashboard_bank_cash_left']" position="inside">
                    <field name="is_credit_card"/>
                    <t t-if="journal_type == 'cash' or record.is_credit_card">
                        <button type="object" name="action_open_credit_card_import_wizard" class="btn btn-primary">Upload</button>
                    </t>
                </xpath>

            </field>
        </record>


        <!-- Add Credit Card Menu and Action -->
        <record id="account_journal_action_add_credit_card" model="ir.actions.server">
            <field name="name">Add Credit Card</field>
            <field name="model_id" ref="account.model_account_journal"/>
            <field name="state">code</field>
            <field name="code">action = model.action_add_credit_card()</field>
        </record>

        <menuitem name="Add Credit Card" id="menu_action_online_add_credit_card_form" parent="account.account_banks_menu" action="account_journal_action_add_credit_card" groups="base.group_no_one" sequence="1"/>

    </data>
</odoo>
