<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!-- Add Fields on Move View -->
        <record id="account_move_form" model="ir.ui.view">
            <field name="name">account.move.form</field>
            <field name="model">account.move</field>
            <field name="inherit_id" ref="account.view_move_form"/>
            <field name="arch" type="xml">

                <xpath expr="//header" position="inside">
                    <button name="refresh_journal_entry_lines" type="object" string="Refresh Entries" class="btn-primary" invisible="move_type != 'entry' or state != 'draft'"/>
                </xpath>

            </field>
        </record>



    </data>
</odoo>
