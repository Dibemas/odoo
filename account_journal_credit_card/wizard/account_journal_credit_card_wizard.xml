<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_credit_card_import_wizard" model="ir.ui.view">
        <field name="name">account.journal.credit.card.import.wizard.form</field>
        <field name="model">account.journal.credit.card.import.wizard</field>
        <field name="arch" type="xml">
            <form string="Import Credit Card CSV" enctype="multipart/form-data">
                <group>
                    <field name="upload_file" />
                    <field name="filename" invisible="1"/>
                    <field name="decimal_separator"/>
                    <field name="thousand_separator"/>
                </group>
                <footer>
                    <button name="action_import_csv" type="object" string="Import" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_credit_card_csv_import" model="ir.actions.act_window">
        <field name="name">Import Credit Card CSV</field>
        <field name="res_model">account.journal.credit.card.import.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>


    <record id="view_account_journal_dashboard_credit_card_button" model="ir.ui.view">
        <field name="name">account.journal.dashboard.credit.card.import</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@id='dashboard_bank_cash_left']" position="inside">
                <field name="is_credit_card" invisible="1"/>
                <br/>
                <t t-if="record.is_credit_card.raw_value == true">
                    <a type="object" name="action_open_credit_card_import_wizard" context="{'default_journal_id': active_id}">
                        Upload
                    </a>
                </t>
            </xpath>

        </field>
    </record>

</odoo>