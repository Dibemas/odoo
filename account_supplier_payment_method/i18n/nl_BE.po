#. module: account_supplier_payment_method
#: model:account.supplier.payment.method,name:account_supplier_payment_method.payment_method_bank_transfer
msgid "Bank transfer"
msgstr "Overschrijving"

#. module: account_supplier_payment_method
#: model:ir.model.fields,help:account_supplier_payment_method.field_account_supplier_payment_method__include_in_payment_run
msgid "Bills with this payment method can be paid through a bank payment file. Leave it off for methods that are paid outside the payment run, such as credit card or direct debit."
msgstr "Facturen met deze betaalmethode kunnen via een betaalbestand voor de bank betaald worden. Laat dit uit voor methodes die buiten de betaalrun betaald worden, zoals kredietkaart of domiciliëring."

#. module: account_supplier_payment_method
#: model:account.supplier.payment.method,name:account_supplier_payment_method.payment_method_credit_card
msgid "Credit Card"
msgstr "Kredietkaart"

#. module: account_supplier_payment_method
#: model:account.supplier.payment.method,name:account_supplier_payment_method.payment_method_direct_debit
msgid "Direct Debit"
msgstr "Domiciliëring"

#. module: account_supplier_payment_method
#: model_terms:ir.actions.act_window,help:account_supplier_payment_method.action_account_supplier_payment_method
msgid "Payment methods describe how a supplier is paid, such as by bank transfer or by direct debit."
msgstr "Betaalmethodes beschrijven hoe een leverancier betaald wordt, bijvoorbeeld met een overschrijving of via domiciliëring."
