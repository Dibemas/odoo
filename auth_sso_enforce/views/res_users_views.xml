<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_users_form_sso_enforce" model="ir.ui.view">
        <field name="name">res.users.form.sso.enforce</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <!--
                Anchored on the access-rights notebook page rather than a
                positional path, so an upstream reordering of the user form does
                not silently drop this field.
            -->
            <xpath expr="//page[@name='access_rights']" position="inside">
                <group string="Authentication" groups="base.group_system">
                    <field name="bypass_sso_enforcement"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
