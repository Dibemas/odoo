<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="ir_mail_server_form_view_bcc" model="ir.ui.view">
            <field name="name">ir.mail_server.bcc</field>
            <field name="model">ir.mail_server</field>
            <field name="inherit_id" ref="base.ir_mail_server_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='smtp_authentication']" position="after">
                    <field name="bcc_active" widget='boolean_toggle'/>
                    <field name="bcc_email" required='bcc_active' invisible='not bcc_active' widget='email'/>
                </xpath>
            </field>
        </record>

    </data>
</odoo>
